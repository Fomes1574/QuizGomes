# Configuração pública e opcional do frontend. Nunca coloque secrets neste arquivo.
VITE_ENABLE_REALTIME_MATCHES=false
# Somente a chave pública Web Push/VAPID do Firebase; nunca coloque a chave privada aqui.
VITE_FIREBASE_VAPID_PUBLIC_KEY=

# Variáveis privadas do Worker ficam em apps/worker/.dev.vars no desenvolvimento
# e em Cloudflare Workers Secrets nos ambientes remotos.
