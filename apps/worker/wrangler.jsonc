{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quiz-gomes",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/temas/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "quizgomes-cbc48"
  },
  "d1_databases": [
    {
      "binding": "CORE_DB",
      "database_name": "quiz-gomes-core",
      "database_id": "3260deba-54ab-4e47-8c7f-a4d088dad728",
      "migrations_dir": "migrations/core"
    },
    {
      "binding": "QUESTIONS_DB",
      "database_name": "quiz-gomes-questions-01",
      "database_id": "40ea8ac4-9dd6-40a8-b032-89cb3cede229",
      "migrations_dir": "migrations/questions"
    }
  ],
  // Limpeza automática de hora em hora (15 dias de jogo, 6 meses de admin) e
  // aviso opcional de ofensiva às ~20h de Brasília (23h UTC).
  "triggers": {
    "crons": ["17 * * * *", "5,20,35,50 23 * * *"]
  },
  // Freio por IP contra rajadas automatizadas (binding de rate limiting do
  // Workers, sem recurso novo a provisionar). Folgado para uso humano.
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 180, "period": 60 } }
  ],
  "r2_buckets": [
    {
      "binding": "QUESTION_IMAGES",
      "bucket_name": "quiz-gomes-question-images"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHALLENGE_ROOM", "class_name": "ChallengeRoom" },
      { "name": "MATCH_ROOM", "class_name": "MatchRoom" },
      { "name": "MATCHMAKING_QUEUE", "class_name": "MatchmakingQueue" },
      { "name": "PRESENCE_HUB", "class_name": "PresenceHub" },
      { "name": "TICKET_BROKER", "class_name": "TicketBroker" },
      { "name": "SOCIAL_REALTIME_HUB", "class_name": "SocialRealtimeHub" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom", "MatchmakingQueue", "PresenceHub", "TicketBroker"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SocialRealtimeHub"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ChallengeRoom"]
    }
  ]
}
